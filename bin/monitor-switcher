#!/usr/bin/env bash
# monitor-switcher — persistent monitor switcher for Omarchy/Hyprland.
#
# Toggle monitors off/on with layout memory: enabled monitors pack
# left-to-right in config order (or sit at explicit positions), each with its
# own scale/mode/transform. Every layout is validated for overlaps before it
# is applied — a colliding layout is refused and the current one kept.
#
# Unlike `hyprctl keyword monitor X,disable` (runtime-only — reverted by any
# hyprctl reload, including the monitor-watch daemon's modeless-recovery
# loop), state is applied through a generated Lua file in Omarchy's toggle
# directory, which every reload re-sources — so off-states survive reloads,
# reboots, and the watcher daemon.
#
# Usage:
#   monitor-switcher state [--json]   Merged config + live state (+ overlap warnings)
#   monitor-switcher plan [--json]    Computed layout boxes (no changes)
#   monitor-switcher toggle <id>      Toggle monitor
#   monitor-switcher enable <id>      Enable monitor
#   monitor-switcher disable <id>     Disable monitor
#   monitor-switcher move <id> <XxY>  Pin monitor to an explicit position
#   monitor-switcher move <id> <left-of|right-of|above|below> <id2>
#   monitor-switcher arrange <json>    Try [{output,x,y}, ...] positions for 20 seconds
#   monitor-switcher swap <a> <b>     Exchange two monitors' places in the pack order
#   monitor-switcher pack             Clear all pinned positions; re-pack left-to-right
#   monitor-switcher scale <id> <factor>  Set scale (rounded to a Hyprland-clean value)
#   monitor-switcher scale-trial <id> <factor>  Try scaling for 20 seconds
#   monitor-switcher focus <id>          Focus a usable monitor (never changes power)
#   monitor-switcher mode <id> <WxH@Hz>  Try an advertised resolution for 20 seconds
#   monitor-switcher refresh <id> <Hz>    Try an advertised rate for 20 seconds
#   monitor-switcher confirm <token>     Keep the pending refresh change
#   monitor-switcher revert <token>      Restore the previous config and layout
#   monitor-switcher apply            Regenerate layout from config + reload
#   monitor-switcher recover          Preview the saved working layout for this monitor set
#
#   <id> = output name (DP-3), alias (MSI), or number — the monitor's place
#   in the pack order, left-to-right (toggle 2). Numbers need no aliases and
#   survive output renumbering, so they suit generic keybinds:
#   SUPER+SHIFT+CTRL+1..N → toggle 1..N.
#
# Files:
#   ~/.config/monitor-switcher/config.json     settings (edit freely)
#   ~/.local/state/monitor-switcher/state.json runtime state (which are off)
#   ~/.local/state/omarchy/toggles/hypr/monitor-switcher.lua  (GENERATED)

set -euo pipefail

CONFIG_DIR="$HOME/.config/monitor-switcher"
CONFIG_FILE="$CONFIG_DIR/config.json"
STATE_DIR="$HOME/.local/state/monitor-switcher"
STATE_FILE="$STATE_DIR/state.json"
TOGGLES_DIR="$HOME/.local/state/omarchy/toggles/hypr"
GENERATED_FILE="$TOGGLES_DIR/monitor-switcher.lua"
PENDING_FILE="$STATE_DIR/refresh-pending.json"
READY_FILE="$STATE_DIR/refresh-watchdog.json"
LOCK_FILE="$STATE_DIR/lock"
WORKING_FILE="$STATE_DIR/working-layouts.json"
PENDING=null
umask 077

die() { echo "monitor-switcher: $*" >&2; exit 1; }

# --- Guarded file I/O -------------------------------------------------------
# Every read/write of the fixed config/state/generated paths funnels through
# these helpers.
#
# Reads (safe_read): a cheap path pre-filter, then a subshell that OPENS the
# file and verifies type + size through the open descriptor
# (/proc/self/fd) — no check-then-open race: whatever inode we opened is
# what we inspect, a swap-in of the pathname after open() is irrelevant, and
# a fifo swapped in BEFORE open() blocks the open and is killed by the
# timeout (fails closed). Size is enforced by the true byte count via the
# descriptor, not by truncation — an oversized file whose capped prefix is
# valid JSON is rejected. Callers (read_json) additionally require valid
# JSON.
#
# Writes (write_file): refuse symlinked parents/targets and go through a
# mktemp file in the same directory plus an atomic rename — a link planted
# at the target is *replaced*, never followed, and a crash mid-write never
# leaves a truncated file behind.
MAX_FILE_BYTES=1048576

guard_path() { # Refuse symlinked ancestors as well as special-file targets.
  local f=$1 parent
  [[ $f == /* && $f != */../* && $f != */./* ]] || return 1
  parent=$(dirname -- "$f")
  while [[ $parent != / ]]; do
    [[ ! -L $parent && ( ! -e $parent || -d $parent ) ]] || return 1
    parent=$(dirname -- "$parent")
  done
  [[ ! -L $f && ( ! -e $f || -f $f ) ]]
}

safe_read() { # <file> — stdout: content iff a real, regular, <=cap file
  local f=$1
  guard_path "$f" || return 1
  [[ -f $f && ! -L $f ]] || return 1 # fast path for the common missing file
  timeout -k 1 3 bash -c '
    f=$1; max=$2
    exec {fd}<"$f" 2> /dev/null || exit 1
    # Inspect the OPENED file, not the pathname: immune to post-open swaps.
    [[ -f /proc/self/fd/$fd ]] || exit 1
    size=$(stat -Lc %s "/proc/self/fd/$fd" 2> /dev/null) || exit 1
    (( size >= 0 && size <= max )) || exit 1
    cat <&"$fd"
  ' _ "$f" "$MAX_FILE_BYTES"
}

read_json() { # <file> — stdout: content iff readable AND valid JSON
  local content
  content=$(safe_read "$1") || return 1
  jq -e . > /dev/null 2>&1 <<<"$content" || return 1
  printf '%s\n' "$content"
}

read_config() { # stdout: validated config; an unreadable config is fatal
  local content
  content=$(read_json "$CONFIG_FILE") \
    || die "cannot read $CONFIG_FILE (missing, not a regular file, symlink, or invalid JSON) — delete it to re-seed"
  validate_config "$content"
  printf '%s\n' "$content"
}

validate_config() {
  local duplicates
  jq -e '
    def positive: type == "number" and isfinite and . > 0;
    type == "array" and all(.[];
      type == "object"
      and (.output | type == "string" and test("^[A-Za-z0-9_.-]+$"))
      and (.alias == null or (.alias | type == "string"))
      and ((.scale // 1) | positive and . >= 0.25 and . <= 5)
      and ((.transform // 0) | type == "number" and . == floor and . >= 0 and . <= 7)
      and ((.mode // "preferred") | type == "string" and
        test("^(preferred|[1-9][0-9]*x[1-9][0-9]*(@[0-9]+(\\.[0-9]+)?)?)$"))
      and (.position == null or (.position | type == "string" and test("^-?[0-9]+x-?[0-9]+$")))
      and (.mode_w == null or (.mode_w | type == "number" and isfinite and . >= 0 and . == floor))
      and (.mode_h == null or (.mode_h | type == "number" and isfinite and . >= 0 and . == floor))
      and (.identity == null or (.identity | type == "object" and
        all(.make, .model, .serial; type == "string"))))
  ' <<<"$1" > /dev/null || die "invalid monitor config: check output, mode, scale, transform and geometry in $CONFIG_FILE"
  duplicates=$(jq -r 'group_by(.output) | map(select(length > 1) | .[0].output) | join(", ")' <<<"$1")
  [[ -z $duplicates ]] || die "duplicate monitor outputs: $duplicates; merge their config entries before applying"
}

write_file() { # <file> — stdin: content. Atomic, symlink-refusing write.
  local f=$1 dir tmp
  guard_path "$f" || die "refusing unsafe path: $f"
  dir=$(dirname -- "$f")
  mkdir -p -- "$dir"
  [[ -d $dir && ! -L $dir ]] || die "refusing to write into $dir: not a real directory (planted link?)"
  [[ ! -L $f ]] || die "refusing to write $f: path is a symlink (planted?)"
  tmp=$(mktemp "$dir/.$(basename -- "$f").XXXXXX")
  if ! cat > "$tmp"; then
    rm -f -- "$tmp"
    die "could not stage write to $f"
  fi
  mv -f -- "$tmp" "$f"
}

remove_file() {
  guard_path "$1" || die "refusing unsafe path: $1"
  rm -f -- "$1"
}

lock_backend() { # [wait-seconds] — a bounded wait: a wedged lock holder (hung
  # hyprctl, a killed process) must surface as an error, never silently freeze
  # every caller; the UI has no other way to time out.
  guard_path "$LOCK_FILE" || die "refusing unsafe lock path: $LOCK_FILE"
  mkdir -p -- "$STATE_DIR"
  # O_RDWR does not block if a FIFO is swapped in; the descriptor check rejects it.
  exec {LOCK_FD}<>"$LOCK_FILE"
  [[ -f /proc/$$/fd/$LOCK_FD ]] || die "unsafe lock file"
  if ! flock -w "${1:-25}" -x "$LOCK_FD"; then
    echo "monitor-switcher: another monitor-switcher operation is still running; retry in a moment" >&2
    return 1
  fi
  guard_path "$LOCK_FILE" && [[ $LOCK_FILE -ef /proc/$$/fd/$LOCK_FD ]] || die "lock path changed while waiting"
}

read_pending() {
  PENDING=null
  guard_path "$PENDING_FILE" || die "refusing unsafe pending transaction path"
  [[ -e $PENDING_FILE ]] || return 0
  PENDING=$(read_json "$PENDING_FILE") || die "cannot read pending refresh transaction"
  jq -e '
    type == "object" and (.token | type == "string" and test("^[a-f0-9]{32}$"))
    and (.output | type == "string") and (.mode | type == "string")
    and (.expiresAt | type == "number" and . > 0 and . == floor)
    and (.reverting == null or (.reverting | type == "boolean"))
    and (.config | type == "string")
    and (.generated == null or (.generated | type == "string"))
    and (.state == null or (.state | type == "string"))
    and (.expected == null or (.expected | type == "array"))
  ' <<<"$PENDING" > /dev/null || die "invalid pending refresh transaction; refusing changes"
}

require_token() {
  [[ $1 =~ ^[a-f0-9]{32}$ ]] || die "invalid refresh token"
  [[ $PENDING != null ]] || { echo "monitor-switcher: no display change is pending" >&2; exit 77; }
  [[ $(jq -r .token <<<"$PENDING") == "$1" ]] || die "refresh token does not match pending change"
}

rollback_required() {
  [[ $PENDING != null ]] && jq -e --argjson now "$(date +%s)" \
    '.reverting == true or .expiresAt <= $now' <<<"$PENDING" > /dev/null
}

restore_refresh() { # Caller holds the lock. Keep the backup until reload succeeds.
  require_token "$1"
  local failed=0
  # Persist this first: neither a failed reload nor a restart may make Keep safe again.
  PENDING=$(jq '.reverting = true' <<<"$PENDING") || return 1
  printf '%s\n' "$PENDING" | write_file "$PENDING_FILE" || return 1
  (jq -j .config <<<"$PENDING" | write_file "$CONFIG_FILE") || failed=1
  if [[ $(jq -r '.generated == null' <<<"$PENDING") == true ]]; then
    (remove_file "$GENERATED_FILE") || failed=1
  else
    (jq -j .generated <<<"$PENDING" | write_file "$GENERATED_FILE") || failed=1
  fi
  if jq -e 'has("state")' <<<"$PENDING" > /dev/null; then
    (jq -j .state <<<"$PENDING" | write_file "$STATE_FILE") || failed=1
  fi
  [[ $failed == 0 ]] || { echo "monitor-switcher: rollback could not restore both files; backup retained in $PENDING_FILE" >&2; return 1; }
  checked_reload || { echo "monitor-switcher: previous files restored, but rollback reload failed; rollback remains pending for retry" >&2; return 1; }
  local expected
  expected=$(jq -c '.expected // []' <<<"$PENDING")
  if [[ $expected != '[]' ]] && ! verify_restored "$expected"; then
    echo "monitor-switcher: previous settings have not reached the displays; rollback remains pending for retry" >&2
    return 1
  fi
  remove_file "$PENDING_FILE" || return 1
  PENDING=null
  echo "refresh reverted; previous config and generated layout restored"
}

bounded_hyprctl() (
  # Do not lend the lock to compositor clients. Kill the entire timeout process
  # group immediately on expiry, including children that ignore TERM or hold pipes.
  exec {LOCK_FD}>&-
  timeout -s KILL 3 bash -c '
    reply=$(hyprctl "$@" 2>&1)
    status=$?
    printf "%s\n" "$reply"
    exit "$status"
  ' _ "$@"
)

checked_reload() {
  local reply errors
  reply=$(bounded_hyprctl reload) \
    || { echo "monitor-switcher: reload failed or timed out: $reply" >&2; return 1; }
  [[ $reply == ok ]] || { echo "monitor-switcher: reload rejected: $reply" >&2; return 1; }
  errors=$(bounded_hyprctl configerrors -j) \
    || { echo "monitor-switcher: could not check configerrors: $errors" >&2; return 1; }
  # Some Hyprland builds report a clean configuration as [""] rather than [].
  jq -e 'type == "array" and all(.[]; type == "string" and test("^\\s*$"))' <<<"$errors" > /dev/null 2>&1 \
    || { echo "monitor-switcher: compositor configerrors: $errors" >&2; return 1; }
}

refresh_watchdog() {
  local token=$1
  [[ $token =~ ^[a-f0-9]{32}$ ]] || die "invalid refresh token"
  # Startup acknowledgement must not take the lock still held by the launcher.
  read_pending
  require_token "$token"
  jq -n --arg token "$token" --argjson pid "$$" '{token: $token, pid: $pid}' | write_file "$READY_FILE"
  while :; do
    sleep 1
    # A busy lock must not kill the watchdog: it is the rollback safety net.
    lock_backend 5 || continue
    read_pending
    [[ $PENDING != null && $(jq -r .token <<<"$PENDING") == "$token" ]] || return 0
    if rollback_required && restore_refresh "$token"; then return 0; fi
    flock -u "$LOCK_FD"
    exec {LOCK_FD}>&-
  done
}

launch_watchdog() {
  local token=$1 script pid ready i
  script=$(readlink -f -- "${BASH_SOURCE[0]}")
  remove_file "$READY_FILE"
  # A fresh session, no terminal/pipes, and no inherited flock (or caller FDs).
  setsid bash -c '
    for fd in /proc/$$/fd/*; do
      n=${fd##*/}
      if [[ $n =~ ^[0-9]+$ ]] && (( n > 2 )); then eval "exec $n>&-"; fi
    done
    exec bash "$1" _refresh-watchdog "$2"
  ' _ "$script" "$token" </dev/null >/dev/null 2>&1 &
  pid=$!
  for i in $(seq 1 40); do
    if ready=$(read_json "$READY_FILE") && jq -e --arg t "$token" '.token == $t' <<<"$ready" > /dev/null; then
      kill -0 "$pid" 2>/dev/null || break
      return 0
    fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.05
  done
  die "could not launch refresh rollback watchdog; change refused"
}

# hyprctl can answer empty, partial, or mid-transition while the compositor
# is busy re-enumerating outputs (reloads, physical hotplug, the watcher's
# modeless-recovery loop). A modeless output is a valid observation, not a
# reason to hide every other display or block recovery. Mutation validation
# below uses configured/advertised geometry and checks the applied result.
live() {
  local out ok geom prev_geom="" i deadline=$((SECONDS + 4))
  for i in $(seq 1 10); do
    if out=$(timeout -k 1 1 hyprctl monitors all -j 2> /dev/null | head -c "$MAX_FILE_BYTES") && [[ -n $out ]]; then
      ok=$(jq -r '
        if (type == "array"
            and all(.[]; type == "object"
              and (.name | type == "string" and test("^[A-Za-z0-9_.-]+$"))
              and all(.width, .height; type == "number" and isfinite and . >= 0)
              and ((.scale // 1) | type == "number" and isfinite and . > 0))
            and (map(.name) | length == (unique | length)))
        then "ok" else "bad" end' <<<"$out" 2> /dev/null) || ok=""
      if [[ $ok == ok ]]; then
        if geom=$(jq -c '[.[] | {name, disabled, width, height, transform, scale, x, y, refreshRate}] | sort_by(.name)' <<<"$out"); then
          if [[ -n $prev_geom && $geom == "$prev_geom" ]]; then
            printf '%s\n' "$out"
            return 0
          fi
          prev_geom=$geom
        fi
      else
        prev_geom=""
      fi
    else
      prev_geom=""
    fi
    (( SECONDS < deadline )) || break
    sleep 0.3
  done
  die "hyprctl monitor data did not settle (compositor busy?)"
}

read_state() {
  local content
  if content=$(read_json "$STATE_FILE"); then
    printf '%s\n' "$content"
  else
    # Missing is normal (first run); present-but-unreadable (planted link,
    # fifo, garbage) gets a warning — and the safe default.
    if [[ -e $STATE_FILE || -L $STATE_FILE ]]; then
      echo "monitor-switcher: ignoring suspect $STATE_FILE; using default state" >&2
    fi
    printf '{"disabled":[]}\n'
  fi
}

is_disabled() { # <output>
  read_state | jq -e --arg o "$1" '.disabled | index($o) != null' > /dev/null
}

set_disabled() { # <output> <true|false>
  local op
  if [[ $2 == true ]]; then
    op='.disabled = (.disabled + [$o] | unique)'
  else
    op='.disabled -= [$o]'
  fi
  read_state | jq --arg o "$1" "$op" | write_file "$STATE_FILE"
}

# Create a config from the current live setup, ordered left-to-right.
seed_config() {
  local seeded
  local lv
  lv=$(live) || return 1
  seeded=$(adopt_new "$(jq 'sort_by(.x)' <<<"$lv")" <<< '[]') || die "could not seed config from live state"
  seeded=$(backfill_geometry "$seeded" "$lv") || return 1
  # First-run adoption preserves the desk, including offsets and vertical stacks.
  seeded=$(jq --argjson lv "$lv" 'map(. as $c | ([$lv[] | select(.name == $c.output)][0]) as $m
    | if $m.disabled != true and $m.width > 0 and $m.height > 0 then .position = "\($m.x // 0)x\($m.y // 0)" else . end)' <<<"$seeded")
  # Build-then-write: the layout is fully derived before write_file stages it.
  [[ -n $seeded ]] || die "could not seed config from live state"
  printf '%s\n' "$seeded" | write_file "$CONFIG_FILE"
  read_state | jq --argjson lv "$lv" '.disabled = ((.disabled // []) + [$lv[] | select(.disabled == true and .name != "FALLBACK") | .name] | unique)' | write_file "$STATE_FILE"
  echo "monitor-switcher: created $CONFIG_FILE from current setup" >&2
}

# Resolve an id to an output name. Ids: an output name, a case-insensitive
# alias, or a bare number — the 1-based place in config order (left-to-right
# pack order), so `toggle 2` needs no alias and survives output renumbering.
resolve() { # <id>
  local cfg
  cfg=$(read_config)
  if [[ $1 =~ ^[0-9]+$ ]]; then
    jq -r --arg n "$1" '($n | tonumber) as $n | select($n >= 1 and $n <= length) | .[$n - 1].output // empty' <<<"$cfg"
    return
  fi
  local matches
  matches=$(jq --arg id "$1" '
    if any(.[]; .output == $id) then [$id] else
      [.[] | select(((.alias // "") | ascii_downcase) == ($id | ascii_downcase)) | .output] end
  ' <<<"$cfg")
  [[ $(jq length <<<"$matches") -le 1 ]] || die "ambiguous monitor alias: $1; use its output name or number"
  jq -r '.[0] // empty' <<<"$matches"
}

# Config plus any connected-but-unlisted monitors appended (rightmost).
adopt_new() { # <live-json> — stdin: current config
  jq --argjson lv "$1" '
    def identity: if ((.serial // "") != "" and (.serial // "") != "0")
      then {make: (.make // ""), model: (.model // ""), serial} else null end;
    . as $cfg
    | map(. as $c | ([$lv[] | select(.name == $c.output)][0] // null) as $m
        | if $m != null then
            ($m | identity) as $id
            | if .identity != null and $id != null and .identity != $id then
                error("hardware identity changed on " + .output + "; reconcile the monitor config")
              elif $id != null then .identity = $id else . end
          elif .identity != null then
            ([$lv[] | select(identity == $c.identity)]) as $matches
            | if ($matches | length) == 1
                and ([$cfg[] | select(.identity == $c.identity)] | length) == 1
                and ([$cfg[].output] | index($matches[0].name)) == null
              then .previousOutput = .output | .output = $matches[0].name else . end
          else . end) as $known
    | $known + [
        $lv[]
        | .name as $n
        | select($n != "FALLBACK")
        | select([$known[].output] | index($n) == null)
        | . as $m | identity as $id
        | { output: .name, alias: (if (.model // "") != "" then .model else .name end), scale: (.scale // 1),
            mode: "preferred", transform: (.transform // 0),
            mode_w: .width, mode_h: .height }
          + (if $id != null then {identity: $id} else {} end)
      ]
  '
}

persist_config() { # Rebind saved off-state when hardware moves to a new connector.
  local cfg=$1 lv=${2:-[]} st old
  validate_config "$cfg"
  old=$(read_config)
  st=$(read_state | jq --argjson cfg "$old" --argjson lv "$lv" '
    .disabled = ((.disabled // []) + [$lv[] | select(.disabled == true and .name != "FALLBACK")
      | .name as $n | select(([$cfg[].output] | index($n)) == null) | $n] | unique)')
  if jq -e 'any(.[]; .previousOutput != null)' <<<"$cfg" > /dev/null; then
    st=$(jq --argjson cfg "$cfg" '
      .disabled |= (map(. as $old | ([$cfg[] | select(.previousOutput == $old)][0].output // $old)) | unique)' <<<"$st")
  fi
  # Quote the right-hand side: in [[ =/!= ]] the RHS is a glob PATTERN, and JSON
  # brackets would be parsed as character classes — silently always "differing".
  if [[ $(jq -c . <<<"$st") != "$(read_state | jq -c .)" ]]; then printf '%s\n' "$st" | write_file "$STATE_FILE"; fi
  cfg=$(jq 'map(del(.previousOutput))' <<<"$cfg")
  # Polling should not rewrite unchanged files (nor trigger file watchers).
  if [[ ! -f $CONFIG_FILE ]] || [[ $(jq -c . <<<"$cfg") != "$(read_config | jq -c .)" ]]; then
    printf '%s\n' "$cfg" | write_file "$CONFIG_FILE"
  fi
}

# Backfill mode_w/mode_h for legacy entries: "preferred"-mode monitors added
# before geometry snapshots existed. Geometry math below reads the CONFIGURED
# mode, never the transient live mode, so layouts don't shift when a monitor
# is briefly running a fallback resolution during re-enumeration.
backfill_geometry() { # <cfg-json> <live-json>
  jq --argjson lv "$2" '
    map(
      if ((.mode // "preferred") == "preferred") and (((.mode_w // 0) <= 0) or ((.mode_h // 0) <= 0)) then
        (. as $c | [$lv[] | select(.name == $c.output)][0] // null) as $m
        | if ($m != null) and (($m.width // 0) > 0) and (($m.height // 0) > 0) then
            . + { mode_w: $m.width, mode_h: $m.height }
          else ([$m.availableModes[]? | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)@[0-9.]+(?:Hz)?$")][0] // null) as $mode
            | if $mode != null then . + {mode_w: ($mode.w | tonumber), mode_h: ($mode.h | tonumber)} else . end
          end
      else . end
      | if (.mode // "preferred") != "preferred" then del(.mode_w, .mode_h) else . end
    )
  ' <<<"$1"
}

# The one place layout geometry is computed. Positions come from the config's
# explicit "position" when present, else pack left-to-right (y=0) in config
# order, continuing rightward from the previous monitor's right edge. Sizes
# come from the configured mode (explicit "WxH@R" parsed; "preferred" uses
# the snapshotted mode_w/mode_h; last resort the settle-checked live mode),
# divided by scale, axes swapped for odd (90°/270°) transforms — the same
# rounding Hyprland uses. Output: JSON array of {output, x, y, w, h} in
# logical pixels, one box per connected + enabled config entry.
layout_boxes() { # <cfg-json> <live-json>
  jq -n --argjson cfg "$1" --argjson lv "$2" --argjson dis "$(read_state | jq -c '.disabled // []')" '
    def msize($c; $m):
      ($c.mode // "preferred") as $mode
      | if ($mode | test("^[0-9]+x[0-9]+")) then
          ($mode | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)")) | [(.w | tonumber), (.h | tonumber)]
        elif (($c.mode_w // 0) > 0 and (($c.mode_h // 0) > 0)) then
          [$c.mode_w, $c.mode_h]
        else
          [($m.width // 0), ($m.height // 0)]
        end;
    def lsz($w; $h; $s; $t):
      (if (($t % 2) == 1) then [$h, $w] else [$w, $h] end) as $d
      | [((($d[0] / $s) + 0.5) | floor), ((($d[1] / $s) + 0.5) | floor)];
    [ foreach $cfg[] as $c ({cursor: 0};
        . as $acc
        | ([$lv[] | select(.name == $c.output)][0] // null) as $m
        | (if ($m == null) or (($dis | index($c.output)) != null) then null
           else
             (msize($c; $m)) as $ms
             | if ($ms[0] > 0 and $ms[1] > 0) then
                 (lsz($ms[0]; $ms[1]; ($c.scale // 1); ($c.transform // 0))) as $ls
                 | (if (($c.position // "") | test("^-?[0-9]+x-?[0-9]+$")) then
                      ($c.position | capture("^(?<px>-?[0-9]+)x(?<py>-?[0-9]+)$")) | [(.px | tonumber), (.py | tonumber)]
                    else [$acc.cursor, 0] end) as $p
                 | {output: $c.output, x: $p[0], y: $p[1], w: $ls[0], h: $ls[1]}
               else null end
           end) as $box
        | {cursor: (if $box == null then $acc.cursor else ($box.x + $box.w) end), box: $box};
        .box // empty) ]
  '
}

# First collision in a box set, "A overlaps B; ...", or empty. AABB overlap:
# rectangles intersect iff each is left-of/below the other's far edge on both
# axes. Touching edges (x == other.x + other.w) is fine — that's packing.
# jq's combinations(n) is a cartesian product WITH replacement (yields self
# pairs and both orderings) — the output< filter keeps unique unordered pairs.
find_overlap() { # <boxes-json>
  jq -r '[combinations(2)
          | select(.[0].output < .[1].output)
          | select(.[0].x < .[1].x + .[1].w and .[1].x < .[0].x + .[0].w
                   and .[0].y < .[1].y + .[1].h and .[1].y < .[0].y + .[0].h)
          | "\(.[0].output) overlaps \(.[1].output)"]
         | join("; ")' <<<"$1"
}

# Re-enabling an output may find its saved slot occupied after an arrangement.
# Reopen horizontal slots by shifting right-hand desktops; otherwise keep
# active desktops fixed and use the nearest free touching edge. All geometry
# uses logical sizes, including scale and rotation.
place_returning_display() { # <output> <live-json>
  local cfg boxes placed inserted
  cfg=$(backfill_geometry "$(read_config)" "$2")
  boxes=$(layout_boxes "$cfg" "$2")
  # For a horizontal row, reopen the saved slot by shifting the right-hand
  # displays together. This restores 1–2–3 after the user joined 1 and 3.
  inserted=$(jq --arg o "$1" '
    def overlaps($a; $b): $a.x < $b.x+$b.w and $b.x < $a.x+$a.w and $a.y < $b.y+$b.h and $b.y < $a.y+$a.h;
    . as $all | ([.[] | select(.output == $o)][0]) as $m
    | [.[] | select(.output != $o)] as $others
    | if $m != null and any($others[]; overlaps(.; $m))
        and (map(.y) | max) < (map(.y + .h) | min)
      then ([$others[] | select(.x < $m.x) | .x + .w] + [$m.x] | max) as $x
        | map(if .output == $o then .x = $x
              elif .x >= $x then .x += $m.w else . end)
      else null end' <<<"$boxes") || return 1
  if [[ $inserted != null && -z $(find_overlap "$inserted") ]]; then
    cfg=$(jq --argjson boxes "$inserted" 'map(. as $c |
      ([$boxes[] | select(.output == $c.output)][0] // null) as $b |
      if $b != null then .position = "\($b.x)x\($b.y)" else . end)' <<<"$cfg") || return 1
    printf "%s\n" "$cfg" | write_file "$CONFIG_FILE"
    return
  fi
  placed=$(jq --arg o "$1" '
    def overlaps($a; $b):
      $a.x < $b.x + $b.w and $b.x < $a.x + $a.w and
      $a.y < $b.y + $b.h and $b.y < $a.y + $a.h;
    ([.[] | select(.output == $o)][0]) as $m
    | [.[] | select(.output != $o)] as $others
    | if $m == null or (any($others[]; overlaps(.; $m)) | not) then null
      else
        [$others[] as $a |
          ([$a.y, $a.y + $a.h - $m.h,
             ([$a.y - $m.h + 1, ([$m.y, $a.y + $a.h - 1] | min)] | max)][] as $y |
            $m + {x: ($a.x + $a.w), y: $y}, $m + {x: ($a.x - $m.w), y: $y}),
          ([$a.x, $a.x + $a.w - $m.w,
             ([$a.x - $m.w + 1, ([$m.x, $a.x + $a.w - 1] | min)] | max)][] as $x |
            $m + {x: $x, y: ($a.y + $a.h)}, $m + {x: $x, y: ($a.y - $m.h)})]
        | map(. as $candidate | select(all($others[]; overlaps(.; $candidate) | not)))
        | sort_by((.x - $m.x)*(.x - $m.x) + (.y - $m.y)*(.y - $m.y), .y, .x)
        | .[0] // error("no free edge for returning display")
      end' <<<"$boxes") || return 1
  [[ $placed != null ]] || return 0
  # Pin the resolved boxes so an unpinned successor cannot follow the moved output.
  cfg=$(jq --argjson boxes "$boxes" --argjson placed "$placed" '
    map(. as $c | ([$boxes[] | select(.output == $c.output)][0] // null) as $b
      | if .output == $placed.output then .position = "\($placed.x)x\($placed.y)"
        elif $b != null then .position = "\($b.x)x\($b.y)" else . end)' <<<"$cfg") || return 1
  printf "%s\n" "$cfg" | write_file "$CONFIG_FILE"
}

# Resolve preferred against trusted geometry, preserving a running advertised
# rate when possible. Never calculate one resolution and ask Hyprland for another.
resolved_mode() { # <config-entry> <live-entry>
  jq -nr --argjson c "$1" --argjson m "$2" '
    if ($c.mode // "preferred") != "preferred" then $c.mode else
      [$m.availableModes[]? | capture("^(?<mode>(?<w>[0-9]+)x(?<h>[0-9]+)@(?<rate>[0-9.]+))(?:Hz)?$")
        | select((.w | tonumber) == $c.mode_w and (.h | tonumber) == $c.mode_h)] as $modes
      | ([$modes[] | select((.rate | tonumber | . * 100 | round) == (($m.refreshRate // 0) * 100 | round))][0]
          // $modes[0]) as $chosen
      | if $chosen != null then $chosen.mode
        elif $m.width == $c.mode_w and $m.height == $c.mode_h and ($m.refreshRate // 0) > 0
          then "\($m.width)x\($m.height)@\($m.refreshRate)"
        else empty end
    end'
}

verify_layout() { # <expected-json>, bounded by the caller.
  local expected=$1 lv settled=0
  while :; do
    if lv=$(timeout -k 1 1 hyprctl monitors all -j 2>/dev/null | head -c 1048576) \
      && jq -e --argjson expected "$expected" '
        . as $lv | all($expected[]; . as $e
          | ([$lv[] | select(.name == $e.output)][0] // null) as $m
          | if $e.disabled then $m == null or $m.disabled == true
            else $m != null and $m.disabled != true and $m.width == $e.width and $m.height == $e.height
              and ((($m.scale // 1) - $e.scale) | fabs) < 0.0001
              and ($m.transform // 0) == $e.transform and $m.x == $e.x and $m.y == $e.y
              and ($e.rate == null or (($m.refreshRate * 100 | round) == ($e.rate * 100 | round)))
            end)
      ' <<<"$lv" > /dev/null 2>&1; then
      settled=$((settled + 1))
      (( settled >= 2 )) && return 0
    else settled=0; fi
    sleep 0.2
  done
}

# The NVIDIA + aquamarine driver wedge: an expected-enabled, physically
# connected output comes back modeless (0x0) because the kernel rejects every
# atomic modeset (EINVAL). Any monitor on any connector can be hit; the fix
# below is hardware-agnostic — it works off the expected layout, not names.
modeless_outputs() { # <expected-json> <live-json> — stdout: names, one per line
  jq -r --argjson lv "$2" '
    .[] | select(.disabled != true) | .output as $o
    | ([$lv[] | select(.name == $o)][0] // null) as $m
    | select($m != null and ($m.disabled != true)
        and (($m.width // 0) <= 0 or ($m.height // 0) <= 0))
    | $o' <<<"$1"
}

# Recovery for the wedge: bounce each modeless output through a disable →
# settle → re-enable cycle so the compositor releases and re-acquires its CRTC,
# then re-apply the intended layout. Uses only hyprctl and the generated rule
# set, so it behaves identically for any monitor combination a user builds.
unwedge_outputs() { # <expected-json> — returns 0 iff every modeless output recovered
  local expected=$1 lv targets target recovered=1
  lv=$(timeout -k 1 2 hyprctl monitors all -j 2>/dev/null | head -c 1048576) || return 1
  targets=$(modeless_outputs "$expected" "$lv")
  [[ -n $targets ]] || return 0
  echo "monitor-switcher: GPU rejected the modeset for: $(paste -sd, <<<"$targets"); attempting driver-level recovery" >&2
  while read -r target; do
    [[ -n $target ]] || continue
    # Release the wedged CRTC. bounded_hyprctl keeps this from hanging.
    bounded_hyprctl eval "hl.monitor({ output = \"$target\", disabled = true })" > /dev/null 2>&1 || true
  done <<<"$targets"
  # Give the driver a beat to finish the teardown before re-acquiring.
  sleep 1
  while read -r target; do
    [[ -n $target ]] || continue
    bounded_hyprctl eval "hl.monitor({ output = \"$target\", disabled = false })" > /dev/null 2>&1 || true
  done <<<"$targets"
  sleep 1
  lv=$(timeout -k 1 2 hyprctl monitors all -j 2>/dev/null | head -c 1048576) || return 1
  [[ -z $(modeless_outputs "$expected" "$lv") ]]
}

# Recovery records are keyed by the connected hardware set, independent of
# connector renumbering. Only successful application/confirmation creates one.
working_key() {
  jq -cn --argjson cfg "$1" --argjson lv "$2" '
    [$lv[] | select(.name != "FALLBACK") | .name as $name
      | ([$cfg[] | select(.output == $name)][0]) as $c
      | if $c.identity != null then {identity: $c.identity} else {output: $name} end]
    | sort_by(tojson) | tojson'
}

read_working() {
  if [[ ! -e $WORKING_FILE && ! -L $WORKING_FILE ]]; then echo '[]'; return; fi
  local value
  value=$(read_json "$WORKING_FILE") || return 1
  jq -e 'type == "array" and length <= 8 and all(.[];
    (.key | type == "string") and (.config | type == "string")
    and (.state | type == "string") and (.expected | type == "array"))' <<<"$value" > /dev/null || return 1
  printf '%s\n' "$value"
}

expected_live() {
  jq -c '[.[] | select(.name != "FALLBACK")
    | if .disabled == true then {output: .name, disabled: true}
      elif .width > 0 and .height > 0 then {output: .name, disabled: false,
        width, height, scale, transform: (.transform // 0), x, y, rate: .refreshRate}
      else empty end]' <<<"$1"
}

verify_restored() {
  local expected=$1 lv
  lv=$(live) || return 1
  # A physically disconnected display cannot be restored. Verify every survivor
  # and require at least one usable screen, rather than deadlocking recovery.
  expected=$(jq -c --argjson lv "$lv" '[.[] | .output as $o | select(any($lv[]; .name == $o))]' <<<"$expected")
  jq -e 'any(.[]; .disabled != true)' <<<"$expected" > /dev/null || return 1
  timeout -k 1 6 bash -o pipefail -c "$(declare -f verify_layout); verify_layout \"\$@\"" _ "$expected"
}

save_working() {
  local expected=$1 cfg st lv key history record
  cfg=$(safe_read "$CONFIG_FILE") || return 1
  st=$(read_state) || return 1
  lv=$(live) || return 1
  key=$(working_key "$cfg" "$lv") || return 1
  history=$(read_working) || return 1
  record=$(jq -n --argjson key "$key" --arg cfg "$cfg" --arg st "$st" --argjson expected "$expected" \
    '{key: $key, config: $cfg, state: $st, expected: $expected}') || return 1
  jq --argjson record "$record" '[$record] + [.[] | select(.key != $record.key)] | .[:8]' <<<"$history" | write_file "$WORKING_FILE"
}

cmd_recover() {
  local lv cfg key history record output
  lv=$(prepare)
  cfg=$(read_config)
  key=$(working_key "$cfg" "$lv")
  history=$(read_working) || die "cannot read saved working layouts"
  record=$(jq -c --argjson key "$key" '[.[] | select(.key == $key)][0] // empty' <<<"$history")
  [[ -n $record ]] || die "no verified layout has been saved for these connected monitors yet"
  cfg=$(jq -r .config <<<"$record")
  validate_config "$cfg"
  jq -e '.state | fromjson | type == "object" and (.disabled | type == "array" and all(.[]; type == "string"))' <<<"$record" > /dev/null || die "invalid saved recovery state"
  output=$(jq -r '[.[] | select(.focused == true)][0].name // .[0].name' <<<"$lv")
  start_trial "$cfg" "$output" recovery "$(jq -r .state <<<"$record")"
}

# Regenerate the layout file from config + state and reload Hyprland.
apply() {
  [[ -s $CONFIG_FILE ]] || seed_config
  local lv cfg boxes collision
  lv=$(live)
  cfg=$(read_config | adopt_new "$lv")
  cfg=$(backfill_geometry "$cfg" "$lv")
  # Never overwrite the user's config with an empty derivation.
  [[ -n $cfg ]] || die "config derivation came back empty; $CONFIG_FILE left untouched"
  persist_config "$cfg" "$lv"
  cfg=$(read_config)

  boxes=$(layout_boxes "$cfg" "$lv")
  # Overlap pre-flight: Hyprland answers an overlapping layout with
  # "Monitor X overlaps with other monitor(s)" and auto-places on top of our
  # rules. Refuse instead, and keep the last known-good generated file.
  collision=$(find_overlap "$boxes")
  [[ -z $collision ]] || die "refusing to apply overlapping layout: $collision (fix with 'monitor-switcher move' or 'pack'; current layout unchanged)"
  [[ $(jq length <<<"$boxes") -gt 0 ]] || die "refusing a layout with no usable display geometry"

  mkdir -p "$TOGGLES_DIR"
  [[ ! -L $TOGGLES_DIR ]] || die "refusing to write into $TOGGLES_DIR: symlink (planted?)"
  # Build the whole file before writing it: write_file stages via mktemp, so
  # the reload below never sources a truncated layout.
  local entry output live_entry mode scale transform box px py expected='[]' mode_size
  local generated="-- GENERATED by monitor-switcher — do not edit.
-- Edit $CONFIG_FILE instead, then run: monitor-switcher apply"
  while read -r entry; do
    output=$(jq -r '.output' <<<"$entry")
    live_entry=$(jq -c --arg o "$output" '[.[] | select(.name == $o)][0] // empty' <<<"$lv")
    [[ -n $live_entry ]] || continue # not connected; keep settings, skip layout
    if is_disabled "$output"; then
      generated+=$(printf '\nhl.monitor({ output = "%s", disabled = true })' "$output")
      expected=$(jq --arg o "$output" '. + [{output: $o, disabled: true}]' <<<"$expected")
      continue
    fi
    box=$(jq -c --arg o "$output" '[.[] | select(.output == $o)][0] // empty' <<<"$boxes")
    [[ -n $box ]] || die "no trusted geometry for $output; choose an advertised mode first"
    mode=$(resolved_mode "$entry" "$live_entry")
    [[ -n $mode ]] || die "no advertised mode matches the saved resolution for $output"
    scale=$(jq -r '.scale // 1' <<<"$entry")
    transform=$(jq -r '.transform // 0' <<<"$entry")
    px=$(jq -r '.x' <<<"$box")
    py=$(jq -r '.y' <<<"$box")
    mode_size=$(jq -n --arg m "$mode" '$m | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)(@(?<rate>[0-9.]+))?$")')
    expected=$(jq --arg o "$output" --argjson size "$mode_size" --argjson s "$scale" \
      --argjson t "$transform" --argjson box "$box" '. + [{output: $o, disabled: false,
        width: ($size.w | tonumber), height: ($size.h | tonumber), rate: (if $size.rate == null then null else ($size.rate | tonumber) end),
        scale: $s, transform: $t, x: $box.x, y: $box.y}]' <<<"$expected")
    generated+=$(printf '\nhl.monitor({ output = "%s", mode = "%s", position = "%sx%s", scale = %s, transform = %s })' \
      "$output" "$mode" "$px" "$py" "$scale" "$transform")
  done < <(jq -c '.[]' <<<"$cfg")
  local previous=null
  if [[ ${1:-} != refresh ]]; then
    guard_path "$GENERATED_FILE" || die "refusing unsafe generated layout path"
    if [[ -e $GENERATED_FILE ]]; then
      previous=$(safe_read "$GENERATED_FILE" | jq -Rs .) || die "cannot back up generated layout"
    fi
  fi
  printf '%s\n' "$generated" | write_file "$GENERATED_FILE" || return 1

  if [[ ${1:-} == refresh ]]; then
    # Validation/generation time must not consume the user's confirmation window.
    PENDING=$(jq --argjson expected "$expected" --argjson expires "$(( $(date +%s) + 20 ))" '.expiresAt = $expires | .appliedExpected = $expected' <<<"$PENDING")
    printf '%s\n' "$PENDING" | write_file "$PENDING_FILE"
  fi
  if checked_reload; then
    if timeout -k 1 6 bash -o pipefail -c "$(declare -f verify_layout); verify_layout \"\$@\"" _ "$expected"; then
      if [[ ${1:-} != refresh ]]; then
        (save_working "$expected") || echo "monitor-switcher: layout applied, but its recovery snapshot could not be saved" >&2
      fi
      return 0
    fi
    # Verification failed. If the signature is a wedged driver (an enabled,
    # connected output stuck modeless), try a CRTC bounce once, then verify
    # again before falling back to rollback.
    if unwedge_outputs "$expected"; then
      if timeout -k 1 6 bash -o pipefail -c "$(declare -f verify_layout); verify_layout \"\$@\"" _ "$expected"; then
        echo "monitor-switcher: recovered the wedged display output without a reboot" >&2
        if [[ ${1:-} != refresh ]]; then
          (save_working "$expected") || echo "monitor-switcher: layout applied, but its recovery snapshot could not be saved" >&2
        fi
        return 0
      fi
    else
      echo "monitor-switcher: the display driver rejected the layout (GPU wedge); recovery failed — a compositor restart or reboot is required" >&2
    fi
    echo "monitor-switcher: applied layout verification failed (mode, scale, position or power did not match)" >&2
  fi
  # Refresh owns its full backup/watchdog rollback; ordinary callers restore config/state.
  [[ ${1:-} != refresh ]] || return 1
  if [[ $previous == null ]]; then
    (remove_file "$GENERATED_FILE") || return 1
  else
    jq -j . <<<"$previous" | write_file "$GENERATED_FILE" || return 1
  fi
  checked_reload || echo "monitor-switcher: previous generated layout restored, but rollback reload failed" >&2
  return 1
}

refresh_info() { # <config> <live> <state>; modes come ONLY from advertised strings.
  jq -n --argjson cfg "$1" --argjson lv "$2" --argjson st "$3" '
    [$cfg[] as $c
      | ([$lv[] | select(.name == $c.output)][0] // null) as $m
      | (if (($c.mode // "preferred") | test("^[0-9]+x[0-9]+")) then
           ($c.mode | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)")) | [(.w | tonumber), (.h | tonumber)]
         else [($c.mode_w // 0), ($c.mode_h // 0)] end) as $size
      | {output: $c.output, configuredWidth: $size[0], configuredHeight: $size[1],
         transform: ($c.transform // 0),
          refreshRate: (if $m != null and $m.disabled != true and ($m.width // 0) > 0 and ($m.height // 0) > 0
                        then ($m.refreshRate // null) else null end),
          availableModes: ([$m.availableModes[]? | strings
            | capture("^(?<mode>(?<w>[0-9]+)x(?<h>[0-9]+)@(?<rate>[0-9]+(?:\\.[0-9]+)?))(?:Hz)?$")
            | {mode, width: (.w | tonumber), height: (.h | tonumber), rate: (.rate | tonumber)}
            | select(.width > 0 and .height > 0 and .rate > 0)] | unique_by(.mode)),
         refreshModes: ([$m.availableModes[]? | strings
           | capture("^(?<mode>(?<w>[0-9]+)x(?<h>[0-9]+)@(?<rate>[0-9]+(?:\\.[0-9]+)?))(?:Hz)?$")
           | select((.w | tonumber) == $size[0] and (.h | tonumber) == $size[1])
           | {mode: .mode, rate: (.rate | tonumber)} | select(.rate > 0)] | unique_by(.rate))}
    ]'
}

state_json() {
  if [[ $STATE_READ_ONLY == false ]]; then [[ -s $CONFIG_FILE ]] || seed_config; fi
  local lv cfg st refresh
  cfg=$(read_config)
  st=$(read_state)
  if [[ $STATE_READ_ONLY == true ]]; then
    # We have a coherent snapshot and will not write; polling must not delay rollback.
    flock -u "$LOCK_FD"
    exec {LOCK_FD}>&-
  fi
  lv=$(live)
  if [[ $STATE_READ_ONLY == false ]]; then
    cfg=$(adopt_new "$lv" <<<"$cfg")
    cfg=$(backfill_geometry "$cfg" "$lv")
    [[ -n $cfg ]] || die "config derivation came back empty; $CONFIG_FILE left untouched"
    persist_config "$cfg" "$lv"
    cfg=$(read_config)
    st=$(read_state)
  fi
  refresh=$(refresh_info "$cfg" "$lv" "$st")
  jq -n --argjson cfg "$cfg" --argjson lv "$lv" --argjson st "$st" \
    --argjson refresh "$refresh" --argjson pending "$PENDING" '
    # Physical diagonal in inches from EDID-reported mm (0 = unknown).
    def inches_of($m):
      (($m.physicalWidth // 0) * ($m.physicalWidth // 0)
       + ($m.physicalHeight // 0) * ($m.physicalHeight // 0))
      | if . > 0 then (sqrt / 25.4 | round) else 0 end;
    # Display class for icon choice: internal panel, ultrawide (pixel aspect),
    # TV-sized (>= 38"), else a regular desktop monitor.
    def kind_of($m; $in):
      if ($m.name | test("^(eDP|LVDS|DSI)-")) then "laptop"
      elif (($m.width // 0) / ([$m.height // 0, 1] | max)) >= 2.3 then "ultrawide"
      elif $in >= 38 then "tv"
      else "monitor" end;
    # Logical on-screen size of a live monitor (axes swapped when rotated).
    def lsz($m):
      (if ((($m.transform // 0) % 2) == 1) then [($m.height // 0), ($m.width // 0)]
       else [($m.width // 0), ($m.height // 0)] end) as $d
      | [((($d[0] / ($m.scale // 1)) + 0.5) | floor), ((($d[1] / ($m.scale // 1)) + 0.5) | floor)];
    [$cfg | to_entries[] | .key as $i | .value as $c
      | ([$lv[] | select(.name == $c.output)][0] // null) as $m
      | (if $m != null then inches_of($m) else 0 end) as $in
      | {
          num: ($i + 1),
          output: $c.output,
          alias: ($c.alias // $c.output),
           scale: (if $m != null and $m.disabled != true and ($m.width // 0) > 0 and ($m.height // 0) > 0 then ($m.scale // 1) else null end),
           configuredScale: ($c.scale // 1),
           liveTransform: ($m.transform // 0),
          mode: ($c.mode // "preferred"),
          position: ($c.position // null),
          connected: ($m != null),
           enabled: (($m != null) and ($m.disabled != true)),
           desiredEnabled: (($st.disabled // [] | index($c.output)) == null),
           usable: ($m != null and $m.disabled != true and ($m.width // 0) > 0 and ($m.height // 0) > 0
                    and $m.dpmsStatus != false and ($m.mirrorOf // "none") == "none"),
           status: (if $m == null then "Disconnected" elif $m.disabled == true then "Off"
                    elif ($m.width // 0) <= 0 or ($m.height // 0) <= 0 then "No active mode"
                    elif $m.dpmsStatus == false then "Asleep" else "On" end),
           focused: (($m.focused == true) and ($m.disabled != true) and ($m.width // 0) > 0 and ($m.height // 0) > 0),
           dpmsStatus: ($m.dpmsStatus // false),
          x: (if $m != null then ($m.x // 0) else 0 end),
          y: (if $m != null then ($m.y // 0) else 0 end),
          width: ($m.width // 0),
          height: ($m.height // 0),
           inches: $in,
           physicalWidth: ($m.physicalWidth // 0),
           physicalHeight: ($m.physicalHeight // 0),
          kind: (if $m != null then kind_of($m; $in) else "monitor" end)
        } + ($refresh[] | select(.output == $c.output))
    ] as $monitors
    # Live overlap check (enabled, non-mirrored monitors only): mirrors share
    # the geometry of their target by design, disabled ones take no space.
    | ([ $lv[] | select((.disabled != true) and ((.mirrorOf // "none") == "none"))
         | . as $m | (lsz($m)) as $s
         | {output: $m.name, x: ($m.x // 0), y: ($m.y // 0), w: $s[0], h: $s[1]} ]) as $boxes
    | { monitors: $monitors,
         refreshPending: ($pending | if . == null then null else {token, output, mode, expiresAt, reverting: (.reverting // false)}
           + (if .mode == "arrangement" then {kind: "arrangement"} else {} end) end),
         enabledCount: ([$monitors[] | select(.usable)] | length),
        overlaps: ([$boxes | combinations(2)
                    | select(.[0].output < .[1].output)
                    | select(.[0].x < .[1].x + .[1].w and .[1].x < .[0].x + .[0].w
                             and .[0].y < .[1].y + .[1].h and .[1].y < .[0].y + .[0].h)
                    | "\(.[0].output) overlaps \(.[1].output)"]) }
  '
}

state_human() {
  state_json | jq -r '
    (.monitors[]
      | (.num | tostring) + "\t" + .output + "\t" + .alias + "\t"
      + (if .connected then (if .enabled then "on" else "off" end) else "unplugged" end)
      + "\t" + (.width | tostring) + "x" + (.height | tostring)
      + " @" + (.scale | tostring) + "x"
      + (if .connected then "\t" + (.x | tostring) + "x" + (.y | tostring) else "" end)),
    (.overlaps[]? | "WARNING: layout overlap: " + .)
  '
}

cmd_toggle() { # <id> <on|off|toggle>
  [[ -s $CONFIG_FILE ]] || seed_config
  local id="$1" action="$2" output
  output=$(resolve "$id")
  [[ -n $output ]] || die "unknown monitor: $id (not an output, alias, or number in $CONFIG_FILE)"

  local lv
  lv=$(live)
  jq -e --arg o "$output" 'any(.[]; .name == $o)' <<<"$lv" > /dev/null \
    || die "$output is not connected"

  local currently next backup config_backup
  backup=$(read_state)
  config_backup=$(read_config)
  if jq -e --arg o "$output" 'any(.[]; .name == $o and .disabled != true)' <<<"$lv" > /dev/null; then currently=on; else currently=off; fi
  case $action in
    toggle) [[ $currently == on ]] && next=off || next=on ;;
    on)  next=on ;;
    off) next=off ;;
  esac

  if [[ $next == off ]]; then
    # Never kill the last enabled, connected display.
    local enabled_others=0 name
    while read -r name; do
      if [[ $name != "$output" ]] \
         && jq -e --arg n "$name" '.[] | select(.name == $n and .disabled != true and .width > 0 and .height > 0
              and .dpmsStatus != false and (.mirrorOf // "none") == "none")' <<<"$lv" > /dev/null \
         && ! is_disabled "$name"; then
        enabled_others=$((enabled_others + 1))
      fi
    done < <(read_config | jq -r '.[].output')
    [[ $enabled_others -gt 0 ]] || die "refusing to disable the last active display"
  fi

  if [[ $next == off ]]; then set_disabled "$output" true; else set_disabled "$output" false; fi
  # Subshell: die inside apply exits the subshell, not us — rollback runs.
  if ! (
    if [[ $next == on && $currently == off ]]; then
      place_returning_display "$output" "$lv" || exit 1
    fi
    apply
  ); then
    # apply refused the layout (its message says why): state.json must not
    # claim a change that never happened — roll the flag back.
    printf '%s\n' "$backup" | write_file "$STATE_FILE"
    printf "%s\n" "$config_backup" | write_file "$CONFIG_FILE"
    die "toggle failed; state left unchanged"
  fi

  local alias
  alias=$(read_config | jq -r --arg o "$output" '.[] | select(.output == $o) | (.alias // .output)')
  if [[ $next == off ]]; then
    echo "$alias ($output) off"
  else
    echo "$alias ($output) on"
  fi
}

# Shared preamble for the position-editing verbs: settle live state, adopt +
# backfill, persist — so resolve() and layout_boxes() see the same config
# apply() will.
prepare() {
  [[ -s $CONFIG_FILE ]] || seed_config
  local lv cfg
  lv=$(live)
  cfg=$(read_config | adopt_new "$lv")
  cfg=$(backfill_geometry "$cfg" "$lv")
  [[ -n $cfg ]] || die "config derivation came back empty; $CONFIG_FILE left untouched"
  persist_config "$cfg" "$lv"
  printf '%s\n' "$lv"
}

cmd_move() { # <id> <XxY|left-of|right-of|above|below> [ref-id]
  local id="$1" what="$2" ref="${3:-}" lv output pos
  lv=$(prepare)
  output=$(resolve "$id")
  [[ -n $output ]] || die "unknown monitor: $id (not an output, alias, or number in $CONFIG_FILE)"

  if [[ $what =~ ^-?[0-9]+x-?[0-9]+$ ]]; then
    pos="$what"
  else
    [[ -n $ref ]] || die "move $what needs a reference monitor: move $id $what <id2>"
    local refout boxes mine theirs
    refout=$(resolve "$ref")
    [[ -n $refout ]] || die "unknown monitor: $ref (not an output, alias, or number in $CONFIG_FILE)"
    [[ $refout != "$output" ]] || die "cannot move $output relative to itself"
    boxes=$(layout_boxes "$(read_config)" "$lv")
    mine=$(jq -c --arg o "$output" '[.[] | select(.output == $o)][0] // empty' <<<"$boxes")
    theirs=$(jq -c --arg o "$refout" '[.[] | select(.output == $o)][0] // empty' <<<"$boxes")
    [[ -n $mine && -n $theirs ]] || die "both monitors must be connected and enabled for relative moves"
    case $what in
      right-of) pos=$(jq -r '"\(.x + .w)x\(.y)"' <<<"$theirs") ;;
      left-of)  pos=$(jq -r --argjson m "$mine" '"\(.x - $m.w)x\(.y)"' <<<"$theirs") ;;
      above)    pos=$(jq -r --argjson m "$mine" '"\(.x)x\(.y - $m.h)"' <<<"$theirs") ;;
      below)    pos=$(jq -r '"\(.x)x\(.y + .h)"' <<<"$theirs") ;;
      *) die "unknown direction: $what (want XxY, left-of, right-of, above, below)" ;;
    esac
  fi

  local backup newcfg alias
  backup=$(read_config)
  newcfg=$(jq --arg o "$output" --arg p "$pos" \
    'map(if .output == $o then . + {position: $p} else . end)' <<<"$backup")
  printf '%s\n' "$newcfg" | write_file "$CONFIG_FILE"
  # Subshell: die inside apply exits the subshell, not us — rollback runs.
  if ! (apply); then
    printf '%s\n' "$backup" | write_file "$CONFIG_FILE"
    die "move reverted; config and layout unchanged"
  fi
  alias=$(read_config | jq -r --arg o "$output" '.[] | select(.output == $o) | (.alias // .output)')
  echo "$alias ($output) at $pos"
}

cmd_swap() { # <a> <b>
  # Exchange two monitors' places in the packing order and drop any pinned
  # positions on both: the pair re-packs, which cannot overlap by
  # construction. (Exchanging raw origins would overlap whenever the two
  # logical widths differ.)
  local lv oa ob backup newcfg
  lv=$(prepare)
  oa=$(resolve "$1")
  [[ -n $oa ]] || die "unknown monitor: $1 (not an output, alias, or number in $CONFIG_FILE)"
  ob=$(resolve "$2")
  [[ -n $ob ]] || die "unknown monitor: $2 (not an output, alias, or number in $CONFIG_FILE)"
  [[ $oa != "$ob" ]] || die "cannot swap $oa with itself"

  backup=$(read_config)
  newcfg=$(jq --arg oa "$oa" --arg ob "$ob" '
    (map(.output) | index($oa)) as $ia
    | (map(.output) | index($ob)) as $ib
    | .[$ia] as $a | .[$ib] as $b
    | .[$ia] = ($b | del(.position)) | .[$ib] = ($a | del(.position))' <<<"$backup")
  printf '%s\n' "$newcfg" | write_file "$CONFIG_FILE"
  # Subshell: die inside apply exits the subshell, not us — rollback runs.
  if ! (apply); then
    printf '%s\n' "$backup" | write_file "$CONFIG_FILE"
    die "swap reverted; config and layout unchanged"
  fi
  echo "swapped $oa and $ob in the packing order (pins cleared; 'move' to re-pin)"
}

cmd_pack() {
  local backup cfg
  [[ -s $CONFIG_FILE ]] || seed_config
  backup=$(read_config)
  cfg=$(jq 'map(del(.position))' <<<"$backup")
  printf '%s\n' "$cfg" | write_file "$CONFIG_FILE"
  # Subshell: die inside apply exits the subshell, not us — rollback runs.
  if ! (apply); then
    printf '%s\n' "$backup" | write_file "$CONFIG_FILE"
    die "pack reverted; config and layout unchanged"
  fi
  echo "positions cleared; monitors pack left-to-right in config order"
}

# Hyprland only accepts scales that divide the mode into whole logical
# pixels (1/120 steps): clean scales are divisors of gcd(w*120, h*120).
# Round the request UP to the nearest clean value (mirrors
# omarchy-hyprland-monitor-scaling, so panel pills and CLI agree).
clean_scale() { # <scale> <mode-w> <mode-h>
  awk -v scale="$1" -v width="$2" -v height="$3" '
    function gcd(a, b, t) { while (b) { t = a % b; a = b; b = t } return a }
    BEGIN {
      g = gcd(width * 120, height * 120)
      k = int(scale * 120 + 0.5)
      if (k > g) k = g
      while (g % k != 0) k++
      printf "%g\n", k / 120
    }'
}

cmd_scale() { # <id> <factor>
  local id="$1" factor="$2" lv output mw mh clean backup newcfg alias
  [[ $factor =~ ^[0-9]+([.][0-9]+)?$ ]] \
    && awk -v s="$factor" 'BEGIN { exit !(s >= 0.25 && s <= 5) }' \
    || die "scale must be a number between 0.25 and 5 (got: $factor)"
  lv=$(prepare)
  output=$(resolve "$id")
  [[ -n $output ]] || die "unknown monitor: $id (not an output, alias, or number in $CONFIG_FILE)"

  # Round against the CONFIGURED mode's geometry, not the live one.
  read -r mw mh <<<"$(read_config | jq -r --arg o "$output" '
    .[] | select(.output == $o)
    | if ((.mode // "preferred") | test("^[0-9]+x[0-9]+")) then
        (.mode | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)") | "\(.w) \(.h)")
      else "\(.mode_w // 0) \(.mode_h // 0)" end')"
  [[ $mw != 0 && $mh != 0 ]] || die "no mode geometry for $output — pin an explicit mode first"
  clean=$(clean_scale "$factor" "$mw" "$mh")

  backup=$(read_config)
  newcfg=$(jq --arg o "$output" --argjson s "$clean" \
    'map(if .output == $o then . + {scale: $s} else . end)' <<<"$backup")
  printf '%s\n' "$newcfg" | write_file "$CONFIG_FILE"
  # Subshell: die inside apply exits the subshell, not us — rollback runs.
  # A scale change reflows packing and can collide with pinned positions;
  # the overlap validator decides, and a refusal leaves everything as it was.
  if ! (apply); then
    printf '%s\n' "$backup" | write_file "$CONFIG_FILE"
    die "scale reverted; config and layout unchanged"
  fi
  alias=$(read_config | jq -r --arg o "$output" '.[] | select(.output == $o) | (.alias // .output)')
  echo "$alias ($output) scale $clean"
}

cmd_focus() {
  local output lv reply
  output=$(resolve "$1")
  [[ -n $output ]] || die "unknown monitor: $1"
  lv=$(live)
  jq -e --arg o "$output" 'any(.[]; .name == $o and .disabled != true and .width > 0 and .height > 0
    and .dpmsStatus != false and (.mirrorOf // "none") == "none")' <<<"$lv" > /dev/null \
    || die "$output has no usable desktop to focus; enable it or restore its mode first"
  # Lua-based Hyprland dispatchers are typed closures, not legacy command strings.
  reply=$(bounded_hyprctl eval "hl.dispatch(hl.dsp.focus({monitor = \"$output\"}))")
  [[ $reply == ok ]] || die "could not focus $output: $reply"
  lv=$(live)
  jq -e --arg o "$output" 'any(.[]; .name == $o and .focused == true)' <<<"$lv" > /dev/null \
    || die "$output did not receive desktop focus"
  echo "$output focused"
}

cmd_plan() { # [--json]
  local lv boxes collision
  lv=$(prepare)
  boxes=$(layout_boxes "$(read_config)" "$lv")
  if [[ ${1:-} == --json ]]; then
    jq '.' <<<"$boxes"
    return
  fi
  jq -r '.[] | .output + "\t" + (.x | tostring) + "x" + (.y | tostring)
         + "\t" + (.w | tostring) + "x" + (.h | tostring) + " logical"' <<<"$boxes"
  collision=$(find_overlap "$boxes")
  [[ -z $collision ]] || echo "WARNING: layout would overlap: $collision" >&2
}

refresh_exit() {
  local status=$1
  trap - EXIT HUP INT TERM
  if (( status != 0 )) && [[ $PENDING != null ]]; then
    echo "monitor-switcher: refresh failed; restoring previous config and generated layout" >&2
    restore_refresh "$(jq -r .token <<<"$PENDING")" || true
  fi
  exit "$status"
}

cmd_refresh() { # <id> <value> [refresh|mode|scale] — shared watchdog transaction
  local id=$1 value=$2 kind=${3:-refresh} rate output cfg lv st info mode newcfg collision clean
  if [[ $kind == refresh ]]; then
    [[ $value =~ ^[0-9]+([.][0-9]+)?$ ]] || die "refresh rate must be a positive number (got: $value)"
    rate=$(jq -en --arg r "$value" '$r | tonumber | select(isfinite and . > 0)') \
      || die "refresh rate must be a positive finite number"
  fi
  cfg=$(read_config)
  output=$(resolve "$id")
  [[ -n $output ]] || die "unknown monitor: $id"
  lv=$(live)
  st=$(read_state)
  jq -e --arg o "$output" --arg kind "$kind" --argjson st "$st" '
    any(.[]; .name == $o and .disabled != true and ($kind == "mode" or (.width > 0 and .height > 0)))
    and (($st.disabled // [] | index($o)) == null)
  ' <<<"$lv" > /dev/null || die "$output must be connected and active to change refresh rate"
  info=$(refresh_info "$cfg" "$lv" "$st" | jq -c --arg o "$output" '.[] | select(.output == $o)')
  case $kind in
    refresh)
      mode=$(jq -r --argjson r "$rate" '.refreshModes[] | select(.rate == $r) | .mode' <<<"$info")
      [[ -n $mode ]] || die "$rate Hz is not advertised at the configured resolution for $output"
      ;;
    mode)
      mode=$(jq -r --arg m "$value" '.availableModes[] | select(.mode == $m) | .mode' <<<"$info")
      [[ -n $mode ]] || die "$value is not an advertised mode for $output"
      ;;
    scale)
      [[ $value =~ ^[0-9]+([.][0-9]+)?$ ]] \
        && jq -en --arg s "$value" '$s | tonumber | select(isfinite and . >= 0.25 and . <= 5)' > /dev/null \
        || die "scale must be a number between 0.25 and 5"
      mode=$(resolved_mode "$(jq -c --arg o "$output" '.[] | select(.output == $o)' <<<"$cfg")" \
        "$(jq -c --arg o "$output" '.[] | select(.name == $o)' <<<"$lv")")
      ;;
  esac
  info=$(jq --arg m "$mode" '. + ($m | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)@(?<r>[0-9.]+)$")
    | {configuredWidth: (.w | tonumber), configuredHeight: (.h | tonumber), rate: (.r | tonumber)})' <<<"$info")
  rate=$(jq -r .rate <<<"$info")
  clean=$(jq -r --arg o "$output" '.[] | select(.output == $o) | .scale // 1' <<<"$cfg")
  [[ $kind != scale ]] || clean=$value
  clean=$(clean_scale "$clean" "$(jq -r .configuredWidth <<<"$info")" "$(jq -r .configuredHeight <<<"$info")")
  newcfg=$(jq --arg o "$output" --arg m "$mode" --argjson s "$clean" \
    'map(if .output == $o then .mode = $m | .scale = $s | del(.mode_w, .mode_h) else . end)' <<<"$cfg")
  collision=$(find_overlap "$(layout_boxes "$newcfg" "$lv")")
  [[ -z $collision ]] || die "refusing to apply overlapping layout: $collision"
  start_trial "$newcfg" "$output" "$mode"
}

cmd_arrange() { # All active displays move together; no intermediate overlaps.
  local positions=$1 lv cfg newcfg boxes collision output
  jq -e '
    type == "array" and length >= 2 and length <= 64
    and all(.[]; type == "object" and (.output | type == "string")
      and all(.x, .y; type == "number" and isfinite and . == floor and . >= -100000 and . <= 100000))
    and (map(.output) | length == (unique | length))
  ' <<<"$positions" > /dev/null 2>&1 || die "arrangement requires unique {output,x,y} entries with integer positions for at least two active displays"
  lv=$(live)
  cfg=$(read_config)
  jq -e --argjson p "$positions" --argjson cfg "$cfg" --argjson st "$(read_state)" '
    ([.[] | select(.disabled != true and .width > 0 and .height > 0 and .dpmsStatus != false
      and (.mirrorOf // "none") == "none") | .name] | sort) as $active
    | ($p | map(.output) | sort) == $active
      and all($p[]; .output as $o | any($cfg[]; .output == $o) and (($st.disabled // [] | index($o)) == null))
  ' <<<"$lv" > /dev/null || die "active displays changed; reopen Arrange and include every active display"
  newcfg=$(jq --argjson p "$positions" 'map(. as $c | ([$p[] | select(.output == $c.output)][0] // null) as $pos
    | if $pos != null then .position = "\($pos.x)x\($pos.y)" else . end)' <<<"$cfg")
  boxes=$(layout_boxes "$newcfg" "$lv")
  collision=$(find_overlap "$boxes")
  [[ -z $collision ]] || die "refusing to apply overlapping layout: $collision"
  jq -e '
    def touches($a; $b):
      ((($a.x + $a.w == $b.x) or ($b.x + $b.w == $a.x)) and
        ([$a.y + $a.h, $b.y + $b.h] | min) > ([$a.y, $b.y] | max)) or
      ((($a.y + $a.h == $b.y) or ($b.y + $b.h == $a.y)) and
        ([$a.x + $a.w, $b.x + $b.w] | min) > ([$a.x, $b.x] | max));
    . as $boxes | reduce range(0; length) as $i ([$boxes[0]];
      . as $seen | $seen + [$boxes[] as $b | select(any($seen[]; touches(.; $b))) | $b] | unique_by(.output))
    | length == ($boxes | length)
  ' <<<"$boxes" > /dev/null || die "display edges must touch so the pointer can move between screens"
  output=$(jq -r '[.[] | select(.focused == true)][0].name // .[0].name' <<<"$lv")
  start_trial "$newcfg" "$output" arrangement
}

start_trial() { # <new-config> <output> <mode-or-arrangement>
  local newcfg=$1 output=$2 mode=$3 newstate=${4:-} token generated backup previous_state expected
  previous_state=$(read_state)
  expected=$(expected_live "$(live)")

  guard_path "$GENERATED_FILE" || die "refusing unsafe generated layout path"
  generated=null
  if [[ -e $GENERATED_FILE ]]; then
    generated=$(safe_read "$GENERATED_FILE" | jq -Rs .) || die "cannot back up generated layout"
  fi
  backup=$(safe_read "$CONFIG_FILE" | jq -Rs .) || die "cannot back up config"
  token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
  [[ $token =~ ^[a-f0-9]{32}$ ]] || die "could not generate refresh token"
  PENDING=$(jq -n --arg token "$token" --arg output "$output" --arg mode "$mode" \
    --argjson expires "$(( $(date +%s) + 20 ))" --argjson config "$backup" --argjson generated "$generated" \
    --arg state "$previous_state" --argjson expected "$expected" \
    '{token: $token, output: $output, mode: $mode, expiresAt: $expires, config: $config, generated: $generated, state: $state, expected: $expected}')
  (( $(LC_ALL=C printf '%s\n' "$PENDING" | wc -c) <= MAX_FILE_BYTES )) || die "refresh backup is too large"
  printf '%s\n' "$PENDING" | write_file "$PENDING_FILE"
  trap 'refresh_exit $?' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  launch_watchdog "$token"
  printf '%s\n' "$newcfg" | write_file "$CONFIG_FILE"
  if [[ -n $newstate ]]; then printf '%s\n' "$newstate" | write_file "$STATE_FILE"; fi
  # apply verifies all affected modes, scales, transforms, positions and power.
  apply refresh
  trap - EXIT HUP INT TERM
  echo "$output refresh $mode pending; confirm $token by $(jq -r .expiresAt <<<"$PENDING") (20-second automatic rollback)"
}

cmd_confirm() {
  require_token "$1"
  if rollback_required; then
    if restore_refresh "$1" >&2; then
      echo "monitor-switcher: preview expired or reverted; previous settings restored; confirmation refused" >&2
      exit 76
    fi
    die "rollback is still pending; confirmation refused; retry Revert"
  fi
  local expected
  expected=$(jq -c ".appliedExpected // []" <<<"$PENDING")
  [[ $expected != "[]" ]] || expected=$(expected_live "$(live)")
  verify_restored "$expected" || die "display state changed during the preview; use Revert"
  (save_working "$expected") || die "cannot save the verified layout; confirmation retained, retry Keep or Revert"
  remove_file "$PENDING_FILE"
  PENDING=null
  echo "refresh confirmed; saved mode kept"
}

usage() {
  # Single-source: print the header comment's Usage block, robust to edits.
  sed -n '/^# Usage:/,/^#   SUPER\+SHIFT\+CTRL/p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

if [[ ${1:-} == _refresh-watchdog ]]; then
  [[ $# -eq 2 ]] || usage
  refresh_watchdog "$2"
  exit
fi

lock_backend
read_pending
STATE_READ_ONLY=false
if [[ $PENDING != null ]]; then STATE_READ_ONLY=true; fi
if rollback_required; then
  case ${1:-} in
    confirm|revert) ;; # These validate their token before attempting recovery.
    *) restore_refresh "$(jq -r .token <<<"$PENDING")" >&2 || true ;;
  esac
fi
if [[ $PENDING != null ]]; then
  case ${1:-} in
    state|focus|confirm|revert) ;;
    *) echo "monitor-switcher: display change pending; confirm or revert its token before other layout changes" >&2; exit 75 ;;
  esac
fi

case "${1:-}" in
  state)
    if [[ "${2:-}" == "--json" ]]; then state_json; else state_human; fi
    ;;
  plan)    cmd_plan "${2:-}" ;;
  toggle)  [[ $# -eq 2 ]] || usage; cmd_toggle "$2" toggle ;;
  enable)  [[ $# -eq 2 ]] || usage; cmd_toggle "$2" on ;;
  disable) [[ $# -eq 2 ]] || usage; cmd_toggle "$2" off ;;
  move)    [[ $# -ge 3 && $# -le 4 ]] || usage; cmd_move "$2" "$3" "${4:-}" ;;
  arrange) [[ $# -eq 2 ]] || usage; cmd_arrange "$2" ;;
  swap)    [[ $# -eq 3 ]] || usage; cmd_swap "$2" "$3" ;;
  pack)    cmd_pack ;;
  scale)   [[ $# -eq 3 ]] || usage; cmd_scale "$2" "$3" ;;
  focus)   [[ $# -eq 2 ]] || usage; cmd_focus "$2" ;;
  mode)    [[ $# -eq 3 ]] || usage; cmd_refresh "$2" "$3" mode ;;
  scale-trial) [[ $# -eq 3 ]] || usage; cmd_refresh "$2" "$3" scale ;;
  refresh) [[ $# -eq 3 ]] || usage; cmd_refresh "$2" "$3" ;;
  confirm) [[ $# -eq 2 ]] || usage; cmd_confirm "$2" ;;
  revert)  [[ $# -eq 2 ]] || usage; restore_refresh "$2" ;;
  recover) cmd_recover ;;
  apply)   apply ;;
  *)       usage ;;
esac
