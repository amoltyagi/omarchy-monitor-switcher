#!/usr/bin/env bash
# Finish display changes even when disabling the screen destroys its panel.
# The worker owns its session and cleanup; the UI only waits for its result.
set -u
backend=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/monitor-switcher
log=$(mktemp "${TMPDIR:-/tmp}/monitor-switcher-action.XXXXXX") || exit 1
setsid --fork --wait bash -o pipefail -c '
  log=$1; backend=$2; shift 2
  trap '\''rm -f -- "$log"'\'' EXIT
  "$backend" "$@" 2>&1 | head -c 65536 > "$log"
  status=${PIPESTATUS[0]}
  cat -- "$log"
  exit "$status"
' monitor-switcher "$log" "$backend" "$@"
status=$?
# Also handles launch failures before the worker could install its cleanup.
rm -f -- "$log"
exit "$status"
